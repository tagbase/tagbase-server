{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "tagbase-job-log"
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Off",
    "editable": false,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Ingest job log",
          "description": "Log lines for one ingest job. The upload page embeds this panel; set job_id to the job's id. The panel refreshes every 15 seconds.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "loki"
                      },
                      "spec": {
                        "expr": "{service_name=\"tagbase_server\"} |= \"job_id=$job_id\""
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "logs",
            "version": "13.1.3",
            "spec": {
              "options": {
                "dedupStrategy": "none",
                "enableInfiniteScrolling": false,
                "enableLogDetails": true,
                "prettifyLogMessage": false,
                "showControls": false,
                "showFieldSelector": false,
                "showLevel": true,
                "showTime": true,
                "sortOrder": "Ascending",
                "timestampResolution": "ms",
                "unwrappedColumns": false,
                "wrapLogMessage": false
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "GridLayout",
      "spec": {
        "items": [
          {
            "kind": "GridLayoutItem",
            "spec": {
              "x": 0,
              "y": 0,
              "width": 24,
              "height": 24,
              "element": {
                "kind": "ElementReference",
                "name": "panel-1"
              }
            }
          }
        ]
      }
    },
    "links": [],
    "liveNow": false,
    "preload": false,
    "tags": ["tagbase", "ingest"],
    "timeSettings": {
      "timezone": "browser",
      "from": "now-1h",
      "to": "now",
      "autoRefresh": "15s",
      "autoRefreshIntervals": ["5s", "10s", "15s", "30s", "1m"],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "title": "Ingest job log",
    "variables": [
      {
        "kind": "TextVariable",
        "spec": {
          "name": "job_id",
          "label": "Job",
          "query": "",
          "current": {
            "text": "",
            "value": ""
          },
          "hide": "hideVariable",
          "skipUrlSync": false
        }
      }
    ]
  }
}
