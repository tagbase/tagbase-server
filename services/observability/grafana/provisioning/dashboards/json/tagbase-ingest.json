            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum by (outcome) (rate(tagbase_ingest_requests_total[5m]))",
                        "legendFormat": "{{outcome}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
