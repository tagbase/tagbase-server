# Example env for the observability Compose profile.
# Keys are alphabetical (dotenv-linter UnorderedKey).
#
# Set ALLOY_CONFIG_FILE=config.cloud.alloy and fill PROM_/LOKI_/TEMPO_
# when exporting to Grafana Cloud instead of the local LGTM stack.
# OTEL_* enables app OTLP export (required with the observability profile).

ALLOY_CONFIG_FILE=config.local.alloy
LOKI_ENDPOINT=
LOKI_PASSWORD=
LOKI_USERNAME=
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4317
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=tagbase_server
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=tagbase
POSTGRES_PASSWORD=tagbase
POSTGRES_PORT=5432
PROM_ENDPOINT=
PROM_PASSWORD=
PROM_USERNAME=
SLACK_BOT_TOKEN=
TEMPO_ENDPOINT=
TEMPO_PASSWORD=
TEMPO_USERNAME=
WEBHOOK=
