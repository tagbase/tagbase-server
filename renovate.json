{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":separateMultipleMajorReleases"],
  "timezone": "America/Los_Angeles",
  "schedule": ["before 9am on Monday"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Drop the abandonmentThreshold inherited from config:best-practices (abandonments:recommended); release inactivity is not a signal we act on",
      "matchPackageNames": ["*"],
      "abandonmentThreshold": null
    },
    {
      "description": "Quarantine new PyPI releases; pin ranges for reproducible deploys",
      "matchManagers": ["pip_requirements"],
      "minimumReleaseAge": "3 days",
      "rangeStrategy": "pin",
      "constraintsFiltering": "strict"
    },
    {
      "description": "Do not pin requires-python; the range is owned with the CI matrix",
      "matchManagers": ["pep621"],
      "matchDepNames": ["python"],
      "enabled": false
    },
    {
      "description": "Keep setuptools as a lower bound, not an exact pin",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["build-system.requires"],
      "rangeStrategy": "bump",
      "minimumReleaseAge": "3 days",
      "constraintsFiltering": "strict"
    },
    {
      "description": "OpenTelemetry Python SDK + instrumentations",
      "matchPackageNames": ["/^opentelemetry-/"],
      "groupName": "opentelemetry"
    },
    {
      "description": "Grafana observability stack images",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "grafana/alloy",
        "grafana/loki",
        "grafana/tempo",
        "grafana/grafana",
        "prom/prometheus"
      ],
      "groupName": "observability stack"
    },
    {
      "description": "Keep PostGIS-related images in lockstep; floating PG-PostGIS tags only",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["kartoza/postgis", "kartoza/pg-backup"],
      "groupName": "postgis",
      "versioning": "regex:^(?<major>\\d+)-(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "allowedVersions": "/^\\d+-\\d+\\.\\d+$/"
    },
    {
      "description": "Group and automerge low-risk GitHub Actions patch/digest updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "digest"],
      "groupName": "github-actions",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ]
}
